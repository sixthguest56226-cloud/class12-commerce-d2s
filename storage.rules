// DEPRECATED / NOT USED:
// Firebase Cloud Storage has been replaced with Google Drive API v3 (drive.file scope)
// to operate 100% free on Firebase Spark plan without requiring the paid Blaze plan.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
